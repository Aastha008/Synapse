# Google Gemini API Key (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional: MongoDB raw event archive (schema-less log payloads).
# Leave unset to run without it — the rest of the platform is unaffected.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=synapse
# RAW_EVENT_TTL_SECONDS=604800
